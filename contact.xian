{{> head }}
<body class="bg-gray-50">
  {{> nav }}
  <div class="container mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-gray-800">Contact Me</h1>
    <p class="mt-4 text-gray-600">Feel free to reach out through the details below.</p>
    <div class="mt-6 bg-white shadow rounded-lg p-6 border border-gray-200 max-w-md">
      <p class="text-gray-700">📧 Email: <a href="mailto:{{ email }}" class="text-blue-600 hover:underline">{{ email }}</a></p>
      <p class="mt-2 text-gray-700">🐙 GitHub: <a href="{{ github }}" class="text-blue-600 hover:underline">{{ github }}</a></p>
    </div>
  </div>
{{> footer }}