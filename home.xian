{{> head }}
<body class="bg-gray-50">
  {{> nav }}
  <div class="container mx-auto px-4 py-12 text-center">
    <h1 class="text-4xl font-bold text-gray-800">Welcome to XianFire 🔥</h1>
    <p class="mt-4 text-lg text-gray-600">{{ message }}</p>
    <p class="mt-2 text-gray-500">This is the <strong>Home</strong> route of {{ name }}.</p>
    <div class="mt-8 flex justify-center space-x-4">
      <a href="/ivan/about" class="bg-blue-600 text-white px-5 py-2 rounded hover:bg-blue-700">About Me</a>
      <a href="/ivan/projects" class="bg-gray-800 text-white px-5 py-2 rounded hover:bg-gray-900">My Projects</a>
    </div>
  </div>
{{> footer }}